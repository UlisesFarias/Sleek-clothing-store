<article class="productCard_article">
    <div class="product">
        
        <div class="img">
            <% product.images.forEach(function(image){ %>
            <img src="/images/Products/<%=image.file%>" alt="">
            <% }); %>
        </div>
        <div class="product-name">
            <h2><%= product.name %></h2>
        </div>
        <div class="price">
                <h3>$<%= product.price %></h3>
        </div>
        <div>
            <span class="span-color">6</span> cuotas sin interés de <span class="span-color">$8.747,92</span>
            </span>
        </div>
        <button class="bnt-carrito">Agregar al carrito</button>
    </div>
    
</article>


