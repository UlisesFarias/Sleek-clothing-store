<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/DetailProduct.css">
    <title>Detalle Producto</title>
</head>
<body>
     <%- include('../partials/header.ejs')%>
    <main>
        <section class="detailProduct">
            <div class="link-top">
                <h5><a href="#">Home/Hoodie/<%= producto.name %></a></h5>
            </div>
            <div class="content-detail d-flex flex-column flex-md-row align-items-center">
                <!-- IMAGEN PRINCIPAL Y MINIATURAS -->
                <div class="image-gallery col-md-6 d-none d-md-flex">
                    <div class="thumbnail-images col-3 d-flex flex-column justify-content-between">
                        <% if (imagenes.length > 0) { %>
                            <% imagenes.forEach((imagen, index) => { %>
                                <img src="/images/Products/<%= imagen %>" class="img-thumbnail mb-2" alt="Imagen <%= index + 1 %>">
                            <% }) %>
                        <% } else { %>
                            <img src="/images/Products/default_image.jpg" class="img-thumbnail mb-2" alt="Imagen predeterminada">
                        <% } %>
                    </div>
                    <div class="main-image col-9">
                        <img id="mainImage" src="/images/Products/<%= imagenes.length > 0 ? imagenes[0] : 'default_image.jpg' %>" class="d-block w-100" alt="Imagen principal">
                    </div>
                </div>
                
                <!-- CARRUSEL -->
                <div id="carouselExampleIndicators" class="carousel slide col-md-6 d-md-none">
                    <div class="carousel-indicators">
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
                    </div>
                    <div class="carousel-inner">
                        <div class="carousel-item active">
                            <img src="/images/Products/17123120871_img_product_.jpg" class="d-block w-100" alt="...">
                        </div>
                        <div class="carousel-item">
                            <img src="/images/Products/1713342432_img_product_.jpg" class="d-block w-100" alt="...">
                        </div>
                        <div class="carousel-item">
                            <img src="/images/Products/17134543471_img_product_.jpg" class="d-block w-100" alt="...">
                        </div>
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
                <!-- fin de carrusel -->

                <div class="product-info col-md-6 text-center text-md-start mt-3 mt-md-0">
                    <div class="product-description">
                        <h2><%= producto.name %></h2>
                        <span>$ <%= producto.price %></span>
                        <p>
                            <i class="fa-solid fa-credit-card"></i>
                            6 cuotas sin interés
                        </p>
                    </div>

                    <div class="product-description-2 mt-3">
                        <h4>TALLE: <%= producto.sizeId %></h4>
                        <div class="d-flex justify-content-center justify-content-md-start">
                            <input type="radio" name="size" value="s" id="size-s"><label for="size-s" class="ms-2 me-3">S</label>
                            <input type="radio" name="size" value="m" id="size-m"><label for="size-m" class="ms-2 me-3">M</label>
                            <input type="radio" name="size" value="l" id="size-l"><label for="size-l" class="ms-2 me-3">L</label>
                            <input type="radio" name="size" value="xl" id="size-xl"><label for="size-xl" class="ms-2 me-3">XL</label>
                        </div>
                    </div>

                    <div class="button-cart text-center text-md-start mt-3">
                        <label for="quantity">Cantidad</label>
                        <input
                            type="number"
                            placeholder="1"
                            value="1"
                            min="1"
                            id="quantity"
                            class="input-quantity"
                        />
                        <button class="btn-add-to-cart btn btn-primary mt-2 mt-md-0 ms-md-3">
                            <i class="fa-solid fa-plus"></i>
                            Añadir al carrito
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <%- include('../partials/footer.ejs') %>

    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-oBqDVmMz4fnFO9gybIVzTI1gVCOGQ5tg1RxMO7xrrUJ8F2OfsQrr89yyTQNVv3aM" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
    <script src="/public/javascripts/cambioImagen.js"></script>
</body>
</html>




